{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        },
        "api/deploy-check.php": {
            "runtime": "vercel-php@0.7.4"
        },
        "api/laravel-check.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "outputDirectory": "public",
    "routes": [
        {
            "src": "/deploy-check",
            "dest": "/api/deploy-check.php"
        },
        {
            "src": "/laravel-check",
            "dest": "/api/laravel-check.php"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
