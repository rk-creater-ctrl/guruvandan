{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        },
        "api/deploy-check.php": {
            "runtime": "vercel-php@0.7.4"
        },
        "api/laravel-check.php": {
            "runtime": "vercel-php@0.7.4"
        },
        "api/asset.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "outputDirectory": "public",
    "routes": [
        {
            "src": "/deploy-check",
            "dest": "/api/deploy-check.php"
        },
        {
            "src": "/laravel-check",
            "dest": "/api/laravel-check.php"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/api/asset.php?path=$1"
        },
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
